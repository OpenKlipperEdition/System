# Makefile define rulles which make kernel.
#	Vars we need from local module:
#
#    KERNEL_BUILD_CONFIG:	# mandatory. which %_defconfig files to configure kernel.
#    KERNEL_IMAGE_PATH:		# mandatory. default arch/mips/boot, PATH store target image, relative to kernel path.
#    KERNEL_TARGET_IMAGE:	# mandatory. default uImage, kernel target image name, eg: uImage, xImage.
#    KERNEL_PATH:		# optional.  default $(TOP_DIR)/kernel
#    KERNEL_CONFIG_PATH:	# optional.  default arch/mips/configs, can be defined anywhere.
#


# TODO: add Vars check.
ifeq ($(KERNEL_BUILD_CONFIG),)
$(error **** KERNEL_BUILD_CONFIG $(KERNEL_BUILD_CONFIG) must be defined! ****)
endif

ifeq ($(KERNEL_TARGET_IMAGE),)
$(warning ***** KERNEL_TARGET_IMAGE $(KERNEL_TARGET_IMAGE) default to 'uImage' ****)
endif

ifeq ($(findstring -,$(LOCAL_MODULE)),-)
$(error **** find '-' in $(LOCAL_PATH)/$(LOCAL_MODULE), "+-*/" is not allowed in LOCAL_MODULE)
endif

define RELATIVE
$(subst $1/,,$2)
endef

define RELATIVE_TOP
$(eval pc=$(filter-out /,$(subst $(1)/,,$(2))))
$(eval pc=$(subst /, ,$(pc)))
$(eval pp:=)
$(foreach m,$(pc),$(eval pp=$(pp)../))
$(pp)
endef

KERNEL_PATH ?=$(TOP_DIR)/kernel
KERNEL_IMAGE_PATH ?=arch/mips/boot/
KERNEL_TARGET_IMAGE ?=uImage
KERNEL_BOARD_REL_PATH:=$(strip $(call RELATIVE,$(TOP_DIR),$(KERNEL_BOARD_PATH)))
KERNEL_REL_TOP_PATH:=$(strip $(call RELATIVE_TOP,$(TOP_DIR),$(KERNEL_PATH)))
KERNEL_BOARD_KERNEL_PATH:=$(KERNEL_REL_TOP_PATH)$(KERNEL_BOARD_REL_PATH)
$(info $(KERNEL_BOARD_KERNEL_PATH),$(KERNEL_BOARD_REL_PATH))
ifneq ($(notdir $(KERNEL_BOARD_OVERLAY_PATH)), )
	KERNEL_COPY_DEPENDDR :=$(shell  cp -rf $(KERNEL_BOARD_OVERLAY_PATH)/* $(KERNEL_PATH))
$(info $(KERNEL_BOARD_OVERLAY_PATH))
else
	KERNEL_COPY_DEPENDDR :=
endif

# Default values

ifeq ($(KERNEL_PATH)/Build.mk, $(wildcard $(KERNEL_PATH)/Build.mk))
$(error ======== $(KERNEL_PATH)/Build.mk found, remove it before going ========)
endif

# each LOCAL_MODULE defines a target.
ifneq ($(LOCAL_MODULE),kernel_vmlinux)
BUILD_KERNEL_TARGET_$(LOCAL_MODULE) :=$(OUT_IMAGE_DIR)/$(LOCAL_MODULE)
else
BUILD_KERNEL_TARGET_$(LOCAL_MODULE) := $(TOP_DIR)/$(TARGET_FS_BUILD)/firmware/
endif

BUILD_KERNEL_INTERMEDIATE:=$(TOP_DIR)/$(OUT_DEVICE_OBJ_DIR)/$(LOCAL_MODULE)-intermediate
BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG:=$(BUILD_KERNEL_INTERMEDIATE)/.config
BUILD_KERNEL_INTERMEDIATE_OBJ:=$(BUILD_KERNEL_INTERMEDIATE)/$(KERNEL_IMAGE_PATH)/$(KERNEL_TARGET_IMAGE)

# if KERNEL_CONFIG_PATH has value, rename defconfig. else use config under kernel src.
ifneq ($(KERNEL_CONFIG_PATH),)
KERNEL_DEFCONFIG:=$(shell echo ingenic_build_$(TARGET_BOARD_PLATFORM)_$(TARGET_PRODUCT_BOARD)_$(LOCAL_MODULE)_$(KERNEL_BUILD_CONFIG))
KERNEL_DEFCONFIG_FILE:=$(KERNEL_CONFIG_PATH)/$(KERNEL_BUILD_CONFIG)

#$(shell cp $(KERNEL_CONFIG_PATH)/$(KERNEL_BUILD_CONFIG) $(KERNEL_PATH)/arch/mips/configs/$(KERNEL_DEFCONFIG))
SOURCE_KERNEL_DEFCONFIG:=$(KERNEL_PATH)/arch/mips/configs/$(KERNEL_DEFCONFIG)
$(SOURCE_KERNEL_DEFCONFIG):$(KERNEL_DEFCONFIG_FILE)
	cp $< $@
else
SOURCE_KERNEL_DEFCONFIG:=$(KERNEL_BUILD_CONFIG)
endif



#$(BUILD_KERNEL_TARGET_$(LOCAL_MODULE)):BUILD_KERNEL_INTERMEDIATE_OBJ:=$(BUILD_KERNEL_INTERMEDIATE_OBJ)
$(BUILD_KERNEL_TARGET_$(LOCAL_MODULE)):$(BUILD_KERNEL_INTERMEDIATE_OBJ)
	mkdir -p $(TOP_DIR)/$(TARGET_FS_BUILD)/firmware
	cp -f $^ $@
# localize vars for this rules.
$(BUILD_KERNEL_INTERMEDIATE_OBJ):$(SOURCE_KERNEL_DEFCONFIG)
$(BUILD_KERNEL_INTERMEDIATE_OBJ):KERNEL_PATH:=$(KERNEL_PATH)
$(BUILD_KERNEL_INTERMEDIATE_OBJ):BUILD_KERNEL_INTERMEDIATE:=$(BUILD_KERNEL_INTERMEDIATE)
$(BUILD_KERNEL_INTERMEDIATE_OBJ):KERNEL_IMAGE_PATH:=$(KERNEL_IMAGE_PATH)
$(BUILD_KERNEL_INTERMEDIATE_OBJ):KERNEL_TARGET_IMAGE:=$(KERNEL_TARGET_IMAGE)
$(BUILD_KERNEL_INTERMEDIATE_OBJ):KERNEL_DEFCONFIG:=$(KERNEL_DEFCONFIG)
$(BUILD_KERNEL_INTERMEDIATE_OBJ):KERNEL_EXT_BOARD_PATH=$(KERNEL_BOARD_KERNEL_PATH)
$(BUILD_KERNEL_INTERMEDIATE_OBJ):KERNEL_CROSS_COMPILE="CROSS_COMPILE=$(DEVICE_COMPILER_PREFIX)-"
ifneq ($(notdir $(KERNEL_BOARD_KERNEL_PATH)), )
#$(BUILD_KERNEL_INTERMEDIATE_OBJ):KERNEL_EXT_BOARD_PATH=$(KERNEL_BOARD_KERNEL_PATH)
OB=OUTSIDE_BUILD=$(KERNEL_EXT_BOARD_PATH)
else
OB:=
#$(BUILD_KERNEL_INTERMEDIATE_OBJ):KERNEL_EXT_BOARD_PATH=$(KERNEL_PATH)/drivers/misc/dummy
endif
ifneq ($(NEED_INSTALL_MODULES), no)
$(BUILD_KERNEL_INTERMEDIATE_OBJ):rootfs $(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG) $(KERNEL_COPY_DEPENDDR)
#	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(KERNEL_TARGET_IMAGE) -j$(MAKE_JLEVEL)
#	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(KERNEL_TARGET_IMAGE) -j$(MAKE_JLEVEL) OUTSIDE_BUILD=$(KERNEL_EXT_BOARD_PATH)
	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(KERNEL_TARGET_IMAGE) -j$(MAKE_JLEVEL) $(OB)
	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) modules -j$(MAKE_JLEVEL) $(OB)
	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(OB) INSTALL_MOD_PATH=$(TOP_DIR)/$(TARGET_FS_BUILD) modules_install
else
$(BUILD_KERNEL_INTERMEDIATE_OBJ):$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG) $(KERNEL_COPY_DEPENDDR)
#	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(KERNEL_TARGET_IMAGE) -j$(MAKE_JLEVEL)
#	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(KERNEL_TARGET_IMAGE) -j$(MAKE_JLEVEL) OUTSIDE_BUILD=$(KERNEL_EXT_BOARD_PATH)
	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(KERNEL_TARGET_IMAGE) -j$(MAKE_JLEVEL) $(OB)
#	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) modules -j$(MAKE_JLEVEL) $(OB)
endif
$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG):KERNEL_PATH:=$(KERNEL_PATH)
$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG):BUILD_KERNEL_INTERMEDIATE:=$(BUILD_KERNEL_INTERMEDIATE)
$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG):KERNEL_EXT_BOARD_PATH:=$(KERNEL_BOARD_KERNEL_PATH)
$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG):KERNEL_CROSS_COMPILE:="CROSS_COMPILE=$(DEVICE_COMPILER_PREFIX)-"
$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG):KERNEL_DEFCONFIG:=$(KERNEL_DEFCONFIG)
ifneq ($(notdir $(KERNEL_BOARD_KERNEL_PATH)), )
#$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG):KERNEL_EXT_BOARD_PATH:=$(KERNEL_BOARD_KERNEL_PATH)
OB=OUTSIDE_BUILD=$(KERNEL_EXT_BOARD_PATH)
else
#$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG):KERNEL_EXT_BOARD_PATH:=$(KERNEL_PATH)/drivers/misc/dummy
OB:=
endif
$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG):$(KERNEL_DEFCONFIG_INTERMEDIATE) $(SOURCE_KERNEL_DEFCONFIG) $(KERNEL_COPY_DEPENDDR)
	echo "config -- $(KERNEL_DEFCONFIG) "
#	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(KERNEL_DEFCONFIG)
#	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(KERNEL_DEFCONFIG) OUTSIDE_BUILD=$(KERNEL_EXT_BOARD_PATH)
	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(KERNEL_DEFCONFIG) $(OB)

LOCAL_MODULE_BUILD=$(LOCAL_MODULE)
include $(BUILD_SYSTEM)/module_install.mk
ifneq ($(LOCAL_FILTER_MODULE),)
ALL_MODULES += $(LOCAL_FILTER_MODULE)
ALL_BUILD_MODULES += $(BUILD_KERNEL_TARGET_$(LOCAL_MODULE))
endif


$(LOCAL_MODULE):$(BUILD_KERNEL_TARGET_$(LOCAL_MODULE))

$(LOCAL_MODULE)-clean:BBB0:=$(BUILD_KERNEL_TARGET_$(LOCAL_MODULE))
$(LOCAL_MODULE)-clean:BBB1:=$(BUILD_KERNEL_INTERMEDIATE)

$(LOCAL_MODULE)-clean:
	rm -rf $(BBB0)
	rm -rf $(BBB1)

ifneq (x$(KERNEL_DEFCONFIG_INTERMEDIATE),x)
$(KERNEL_DEFCONFIG_INTERMEDIATE)-clean:
	rm -f $(subst -clean,,$@)

$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG)-touch:
	touch $(subst -touch,,$@)
$(LOCAL_MODULE)-build:$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG)-touch $(BUILD_KERNEL_INTERMEDIATE_OBJ)
endif

$(LOCAL_MODULE)-config:$(BUILD_KERNEL_INTERMEDIATE_DOT_CONFIG)


# localize VARIABLES
$(LOCAL_MODULE)-%:KERNEL_PATH:=$(KERNEL_PATH)
$(LOCAL_MODULE)-%:BUILD_KERNEL_INTERMEDIATE:=$(BUILD_KERNEL_INTERMEDIATE)
$(LOCAL_MODULE)-%:LOCAL_MODULE:=$(LOCAL_MODULE)
$(LOCAL_MODULE)-%:KERNEL_EXT_BOARD_PATH:=$(KERNEL_BOARD_KERNEL_PATH)
$(LOCAL_MODULE)-%:KERNEL_CROSS_COMPILE="CROSS_COMPILE=$(DEVICE_COMPILER_PREFIX)-"
ifneq ($(notdir $(KERNEL_BOARD_KERNEL_PATH)), )
#$(LOCAL_MODULE)-%:KERNEL_EXT_BOARD_PATH:=$(KERNEL_BOARD_KERNEL_PATH)
OB=OUTSIDE_BUILD=$(KERNEL_EXT_BOARD_PATH)
else
#$(LOCAL_MODULE)-%:KERNEL_EXT_BOARD_PATH:=$(KERNEL_PATH)/drivers/misc/dummy
OB:=
endif
$(LOCAL_MODULE)-%:$(KERNEL_COPY_DEPENDDR)
	echo $@
#	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(subst $(LOCAL_MODULE)-,,$@)
#	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(subst $(LOCAL_MODULE)-,,$@) OUTSIDE_BUILD=$(KERNEL_EXT_BOARD_PATH)
	make $(KERNEL_CROSS_COMPILE) -C $(KERNEL_PATH) O=$(BUILD_KERNEL_INTERMEDIATE) $(subst $(LOCAL_MODULE)-,,$@) $(OB)

.PHONY: $(BUILD_KERNEL_INTERMEDIATE_OBJ)

# clear VARS
KERNEL_PATH :=
KERNEL_IMAGE_PATH :=
KERNEL_TARGET_IMAGE :=
KERNEL_CONFIG_PATH :=
BUILD_KERNEL_INTERMEDIATE :=
BUILD_KERNEL_INTERMEDIATE_OBJ:=

.PHONY:$(LOCAL_MODULE) $(LOCAL_MODULE)-clean $(LOCAL_MODULE)-config $(LOCAL_MODULE)-build $(LOCAL_MODULE)-%
