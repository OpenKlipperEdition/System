	ingenic,gpio-sleep-hiz		= <>;
	ingenic,gpio-sleep-low		= <>;
	ingenic,gpio-sleep-high		= <>;
	ingenic,gpio-sleep-func0    = <>;
	ingenic,gpio-sleep-func1    = <>;
	ingenic,gpio-sleep-func2    = <>;
	ingenic,gpio-sleep-func3    = <>;
};

&gpc {
