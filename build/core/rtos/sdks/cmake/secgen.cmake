set(LOCAL_SUBSEC_OBJCOPY_BIN ${LOCAL_SECTION_TARGET}.${LOCAL_SECTION_TYPE}.bin)
set(CMAKE_LINKER "${CMAKE_CROSS_COMPLILER}ld")
set(CMAKE_C_LINK_EXECUTABLE
  "<CMAKE_LINKER> <FLAGS> <OBJECTS> <CMAKE_C_LINK_FLAGS> <LINK_FLAGS> -o <TARGET> <LINK_LIBRARIES>")

get_property(CMAKE_EXE_LINKER_FLAGS GLOBAL PROPERTY LINK_FLAGS)

#
# generate section.ld, before LOCAL_SECTION_TARGET build process command
#
add_dependencies(${LOCAL_SECTION_TARGET} glds-${LOCAL_SECTION_TARGET})
add_custom_target(glds-${LOCAL_SECTION_TARGET} ALL DEPENDS ${LOCAL_SECTION_TARGET}.lds)

set(TMPLD ${CMAKE_CURRENT_BINARY_DIR}/${LOCAL_SECTION_TARGET}.lds)
set_target_properties(${LOCAL_SECTION_TARGET} PROPERTIES
  LINK_DEPENDS  ${TMPLD}
  LINK_FLAGS "-T ${LOCAL_SECTION_TARGET}.lds")


add_custom_command(OUTPUT ${LOCAL_SECTION_TARGET}.lds
  COMMAND python ${SYS_MKRTOSLDS_CMD} ${LOCAL_IMPORT_FILE} ${SYS_SECTION_LDS}
  ${SYS_SYSTEM_MAP} ${SYS_SECTION_JSON} ${LOCAL_SECTION_TYPE} > ${LOCAL_SECTION_TARGET}.lds
  DEPENDS ${SYS_SECTION_LDS} ${SYS_SECTION_JSON} ${SYS_SYSTEM_MAP}
	  ${SYS_MKRTOSLDS_CMD}  ${LOCAL_IMPORT_FILE} ghost-tools ${CMAKE_BINARY_DIR}/host-tools/mkrtoslds${EXEC_EXTENTION_SUFFIX}
  BYPRODUCTS ${LOCAL_SECTION_TARGET}.lds
  COMMAND ${CMAKE_BINARY_DIR}/host-tools/mkrtoslds
  COMMENT "sub section spec ldscript generate"
  VERBATIM)

#
# generate binary file
#
add_custom_target(gsubsec-${LOCAL_SUBSEC_OBJCOPY_BIN} ALL DEPENDS ${LOCAL_SUBSEC_OBJCOPY_BIN})
add_custom_command(OUTPUT ${LOCAL_SUBSEC_OBJCOPY_BIN}
  COMMAND  ${CMAKE_OBJCOPY} -O binary ${LOCAL_SECTION_TARGET} ${LOCAL_SUBSEC_OBJCOPY_BIN}
  # COMMAND ${CMAKE_COMMAND} -E echo $<TARGET_FILE:${LOCAL_SECTION_TARGET}>
  # COMMENT "Generating ${LOCAL_SUBSEC_OBJCOPY_BIN}"
  DEPENDS ${LOCAL_SECTION_TARGET}
  VERBATIM)

set_property(GLOBAL APPEND PROPERTY GSUB_SECTION_BINS
   ${CMAKE_CURRENT_BINARY_DIR}/${LOCAL_SUBSEC_OBJCOPY_BIN})

set_property(GLOBAL APPEND PROPERTY GSUB_SECTION_BINS_TARGET
  "gsubsec-${LOCAL_SUBSEC_OBJCOPY_BIN}")
