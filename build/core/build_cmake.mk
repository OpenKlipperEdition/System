CMAKE_BUILD_MAKEFILE:=$(OUT_DEVICE_OBJ_DIR)/$(LOCAL_PATH)/$(LOCAL_MODULE)/Makefile
LOCAL_MODULE_BUILD:=$(LOCAL_MODULE)
LOCAL_MODULE_STAMP:=$(dir $(CMAKE_BUILD_MAKEFILE)).stampinstall

include $(BUILD_SYSTEM)/base_ruler.mk
include $(BUILD_SYSTEM)/module_install.mk
ifneq (x$(LOCAL_FILTER_MODULE),x)
ALL_MODULES += $(LOCAL_FILTER_MODULE)
ALL_MODULES += $(LOCAL_DEPANNER_MODULES)
ALL_BUILD_MODULES += $(DEPANNER_MODULE)
endif
# remove all CMAKE module clean from ALL_MODULES_CLEAN, which maybe
# conflict with '$(LOCAL_MODULE)-clean' in this file
ALL_MODULES_CLEAN_FILTER += $(LOCAL_MODULE_BUILD)

LOCAL_MODULE_BUILD_FORCE:=$(LOCAL_MODULE)-FORCE
MMA_MODULES += $(LOCAL_MODULE_BUILD_FORCE)

MAKEPARAM=-j1
ifneq (x$(MAKE_JLEVEL),x)
	MAKEPARAM=-j$(MAKE_JLEVEL)
endif

DEPANNER_MODULE:=$(OUT_DEVICE_OBJ_DIR)/DEPANNER/$(LOCAL_MODULE)-intermediate/stamp_build \
	$(OUT_DEVICE_OBJ_DIR)/DEPANNER/$(LOCAL_MODULE)-intermediate/stamp_install



$(LOCAL_MODULE_BUILD_FORCE):LOCAL_CMAKE_BUILD_MAKEFILE:=$(CMAKE_BUILD_MAKEFILE)

ifeq ($(strip $(USE_LEGACY_BUILD_SYSTEM)),YES)
$(LOCAL_MODULE_BUILD_FORCE):$(LOCAL_MODULE)
	cd $(dir $(LOCAL_CMAKE_BUILD_MAKEFILE)) && make &&\
	make DESTDIR=$(TOP_DIR)/$(TARGET_FS_BUILD) install/fast && \
	cd -
else
$(LOCAL_MODULE_BUILD_FORCE):$(LOCAL_MODULE)
	cd $(dir $(LOCAL_CMAKE_BUILD_MAKEFILE)) && make &&\
	make DESTDIR=$(TOP_DIR)/$(SYSROOT) install/fast &&\
	make DESTDIR=$(TOP_DIR)/$(TARGET_FS_BUILD) install/fast && \
	cd -

endif

$(LOCAL_MODULE_BUILD_FORCE)-clean:$(LOCAL_MODULE)-clean
$(LOCAL_MODULE_STAMP):rootfs
$(LOCAL_MODULE_STAMP):LOCAL_CMAKE_PATH:=$(CMAKE_PATH)
$(LOCAL_MODULE_STAMP):LOCAL_CMAKE_CONF_OPTS:=$(CMAKE_CONF_OPTS)

$(LOCAL_MODULE): $(LOCAL_DEPANNER_MODULES) $(DEPANNER_MODULE)

$(DEPANNER_MODULE):$(LOCAL_MODULE_STAMP)
	$(hide) mkdir -p $(dir $@)
	$(hide) install -D /dev/null $@

#$(LOCAL_MODULE_STAMP):$(LOCAL_DEPANNER_MODULES)

__destdir:=
ifeq (x$(strip $(LOCAL_CMAKE_DESTDIR)),x)
	__destdir:=$(TOP_DIR)/$(SYSROOT) $(TOP_DIR)/$(TARGET_FS_BUILD)
else
	__destdir:=$(LOCAL_CMAKE_DESTDIR)
endif

ifeq ($(strip $(USE_LEGACY_BUILD_SYSTEM)),YES)
$(LOCAL_MODULE_STAMP):$(CMAKE_BUILD_MAKEFILE)
	$(if $(strip $(LOCAL_CMAKE_DESTDIR)), \
		@echo "Warning: LOCAL_CMAKE_DESTDIR is ignored!")
	cd $(dir $<) && make $(MAKEPARAM) &&\
	make DESTDIR=$(TOP_DIR)/$(TARGET_FS_BUILD) install/fast && \
	cd -
	$(hide)install -D /dev/null $@
else
$(LOCAL_MODULE_STAMP):__install_dir:=$(__destdir)
$(LOCAL_MODULE_STAMP):$(CMAKE_BUILD_MAKEFILE)
	cd $(dir $<) && make $(MAKEPARAM) &&\
	$(foreach dir,$(__install_dir), $(MAKE) DESTDIR=$(dir) install/fast &&):
	$(hide)install -D /dev/null $@
endif

$(LOCAL_MODULE)-clean:LOCAL_CMAKE_BUILD_MAKEFILE:=$(CMAKE_BUILD_MAKEFILE)
$(LOCAL_MODULE)-clean:LOCAL_DEPANNER_MODULE:=$(DEPANNER_MODULE)
$(LOCAL_MODULE)-clean:
	rm -rf $(dir $(LOCAL_CMAKE_BUILD_MAKEFILE))
	rm -rf $(dir $(LOCAL_DEPANNER_MODULE))

$(CMAKE_BUILD_MAKEFILE):$(CMAKE_TEMPLATE)
	mkdir -p $(dir $@)
	rm -f CMakeCache.txt
	cd $(dir $@) && LD_LIBRARY_PATH=$(LIB_ENV) $(CMAKE_TOOL) $(TOP_DIR)/$(LOCAL_CMAKE_PATH) \
		-DCMAKE_TOOLCHAIN_FILE=$(TOP_DIR)/$(CMAKE_TEMPLATE) \
		-DCMAKE_INSTALL_PREFIX="/usr" \
		-DCMAKE_COLOR_MAKEFILE=OFF \
		-DBUILD_DOC=OFF \
		-DBUILD_DOCS=OFF \
		-DBUILD_EXAMPLE=OFF \
		-DBUILD_EXAMPLES=OFF \
		-DBUILD_TEST=OFF \
		-DBUILD_TESTS=OFF \
		-DBUILD_TESTING=OFF \
		-DBUILD_SHARED_LIBS=$(if $(LOCAL_STATIC_LIBS),OFF,ON) \
		$(LOCAL_CMAKE_CONF_OPTS) && cd -
