
LOCAL_MODULE_BUILD=$(LOCAL_MODULE)
MODULE_BUILD_MAKEFILE:=$(OUT_DEVICE_OBJ_DIR)/$(LOCAL_PATH)/$(LOCAL_MODULE)/Makefile


include $(BUILD_SYSTEM)/module_install.mk
ifneq (x$(LOCAL_FILTER_MODULE),x)
ALL_MODULES += $(LOCAL_DEPANNER_MODULES)
ALL_MODULES += $(LOCAL_FILTER_MODULE)
ALL_BUILD_MODULES += $(LOCAL_MODULE_STAMP)
endif

LOCAL_MODULE_BUILD_FORCE:=$(LOCAL_MODULE)-FORCE
MMA_MODULES += $(LOCAL_MODULE_BUILD_FORCE)

MAKEPARAM=-j1
ifneq (x$(MAKE_JLEVEL),x)
	MAKEPARAM=-j$(MAKE_JLEVEL)
endif

QTARGET_COPYS_$(LOCAL_MODULE):=
QTARGET_COPYS_INSTALL:=$(OUT_DEVICE_OBJ_DIR)/$(LOCAL_PATH)/$(LOCAL_MODULE).stampinstall

$(LOCAL_MODULE_BUILD_FORCE)-clean:$(LOCAL_MODULE)-clean
$(LOCAL_MODULE)-clean:$(QTARGET_COPYS_INSTALL)-clean

$(LOCAL_MODULE):rootfs


$(MODULE_BUILD_MAKEFILE):LOCAL_CONF_OPTS:=$(QMAKE_CONF_OPTS)
$(MODULE_BUILD_MAKEFILE):LOCAL_QMAKE_PATH:=$(QMAKE_PATH)
$(MODULE_BUILD_MAKEFILE): $(QMAKE_SPEC_FILE) $(QMAKE)
	@mkdir -p $(dir $@)
	$(QMAKE) $(LOCAL_CONF_OPTS) -spec $(dir $(QMAKE_SPEC_FILE)) $(LOCAL_QMAKE_PATH) -o $@

include $(BUILD_SYSTEM)/module_copy_file.mk

$(QTARGET_COPYS_INSTALL):$(MODULE_BUILD_MAKEFILE)
	@mkdir -p $@
	@make -C $(dir $^) $(MAKEPARAM)
	@make -C $(dir $^) install $(MAKEPARAM)

$(QTARGET_COPYS_INSTALL)-clean:
	rm -fr $(dir $(QTARGET_COPYS_INSTALL))

$(LOCAL_MODULE):$(QTARGET_COPYS_INSTALL)


ifneq (x$(QTARGET_COPYS),x)

$(foreach filecell, $(strip $(QTARGET_COPYS)), \
	$(eval $(call separate_vars,$(filecell))) \
	$(eval $(call target_copy_file,$(src),$(target),$(SYSROOT),$(QTARGET_COPYS_INSTALL))))
endif
