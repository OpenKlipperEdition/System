set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR mips)

if(${CMAKE_HOST_SYSTEM_NAME} MATCHES "Linux")
  set(CMAKE_CROSS_COMPLILER  "${CMAKE_SOURCE_DIR}/prebuilts/toolchains/mips-gcc-glibc/bin/$(DEVICE_COMPILER_PREFIX)-")
  set(EXEC_EXTENTION_SUFFIX "")
else()
  set(CMAKE_CROSS_COMPLILER  "${CMAKE_SOURCE_DIR}/prebuilts/toolchains/mips-gcc-win/bin/$(DEVICE_COMPILER_PREFIX)-") # toolchains need have -win
  set(EXEC_EXTENTION_SUFFIX ".exe")
endif()

set(CMAKE_C_COMPILER   "${CMAKE_CROSS_COMPLILER}gcc${EXEC_EXTENTION_SUFFIX}")
set(CMAKE_CXX_COMPILER "${CMAKE_CROSS_COMPLILER}g++${EXEC_EXTENTION_SUFFIX}")
#set(CMAKE_AR "${CMAKE_CROSS_COMPLILER}ar")
set(CMAKE_OBJCOPY "${CMAKE_CROSS_COMPLILER}objcopy"  CACHE STRING "CROSS OBJCOPY" FORCE)
